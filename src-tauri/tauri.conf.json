{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu!mosis",
  "version": "0.4.2",
  "identifier": "io.github.debuzzz.osumosis",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:3000; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/osumosis-node"],
    "resources": { "../.desktop/backend/": "backend/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
